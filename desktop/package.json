{
  "name": "cinehub-desktop",
  "productName": "CineHub",
  "version": "1.0.0",
  "description": "CineHub for Windows PC / laptop",
  "private": true,
  "main": "src/main/main.js",
  "author": "CineHub",
  "license": "SEE LICENSE IN ../LICENSE",
  "scripts": {
    "prepare:assets": "node scripts/prepare.mjs",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build": "npm run prepare:assets && npm run build:renderer",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "test": "node scripts/selftest.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dashjs": "^4.7.4",
    "hls.js": "^1.5.15"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.10",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.cinehub.desktop",
    "productName": "CineHub",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/**/*",
      "src/shared/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "CineHub-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "CineHub-Portable-${version}-${arch}.${ext}"
    }
  }
}
